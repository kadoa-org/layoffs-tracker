{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "layoffs.kadoa.com"
        }
      ],
      "destination": "https://www.kadoa.com/layoffs/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "layoffs.kadoa.com"
        }
      ],
      "destination": "https://www.kadoa.com/layoffs/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/layoffs/((?!data/|assets/|favicon|robots|sitemap).*)",
      "destination": "/layoffs/index.html"
    }
  ]
}
